    {
      "@type": "Question",
      "@id": "https://brockdsimon.com/profile.jsonld#faq-career-mckinsey-asia-emphasis",
      "name": "How did his McKinsey work in Asia differ in emphasis?",
      "url": "https://brockdsimon.com/profile#faq-career-mckinsey-asia-emphasis",
      "about": {
