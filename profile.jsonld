    {
      "@type": "Quotation",
      "@id": "https://brockdsimon.com/profile.jsonld#perspective-ai-shopping-discovery-upstream",
      "text": "To me, the bigger shift is watching that discovery move upstream",
      "description": "The bigger shift in AI shopping is discovery moving upstream, before the shopper reaches a retailer. Systems that ground the difference between a marketing claim and a verified one do not yet exist, and both AI models and shoppers are still in a norming stage.",
      "about": "AI-mediated shopping and product data",
      "spokenByCharacter": {
